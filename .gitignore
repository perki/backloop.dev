*/node_modules
renew/secret*.env.sh
renew/gh-pages
.DS_Store
# The website is authored by hand and has no other source, so it is committed.
# Everything else under dist/ is generated or secret — certificate directories
# above all — so this is an allowlist: anything not named here stays ignored.
/dist/*
!/dist/index.html
!/dist/llms.txt
!/dist/llms-full.txt
!/dist/robots.txt
# The public certificate directory: its install page is authored by hand and is
# committed, everything else in it is generated by tools/build-public-pack.js.
# The key there is public by design, but it stays out of git anyway: GitHub's
# push protection blocks private keys, and the rule "no key is ever committed"
# is worth more than the one file it would save.
!/dist/public/
/dist/public/*
!/dist/public/index.html
/_temp

# The secret is never committed: the repository is public.
backloop.dev.json
.backloop.dev.json

# Development checkouts of the two package repositories, cloned by tools/setup.sh.
# They are separate git repositories with their own remotes.
/packages/
